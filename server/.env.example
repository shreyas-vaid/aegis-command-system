# AEGIS Server Environment Configuration
# Copy this file to .env and fill in your values

# MongoDB connection string (MongoDB Atlas or local)
# Leave blank to run with automated In-Memory demo store
MONGODB_URI=

# Server port
PORT=5000

# Client URL for CORS (Vite dev server default or production frontend)
CLIENT_URL=http://localhost:5173

# Node environment
NODE_ENV=development
