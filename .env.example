# ==================================================
# AEGIS SYSTEM ENVIRONMENT CONFIGURATION (.env.example)
# ==================================================

# ─── BACKEND CONFIG (server/.env) ─────────────────
# MongoDB connection URI (Atlas or local)
# Required for user registration, operational missions, and persistence.
# In development without MongoDB, server boots in demo/scenario-027 mode only.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aegis?retryWrites=true&w=majority

# Backend Server Port (defaults to 5000; Render sets automatically)
PORT=5000

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# Node Environment ('development' | 'production')
NODE_ENV=development

# JWT Authentication Secret (Required in production)
# In development, defaults to local dev key if left unset
JWT_SECRET=your-random-32-character-secret-key-for-jwt-signing

# ─── FRONTEND CONFIG (client/.env) ────────────────
# Set in Vercel Project Settings -> Environment Variables before building!
# In local development, leave blank (Vite proxies /api to http://localhost:5000 automatically)
# In production, set to your Render backend URL:
# Example: VITE_API_URL=https://aegis-api.onrender.com
VITE_API_URL=
