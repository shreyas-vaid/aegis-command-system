# ==================================================
# AEGIS SYSTEM ENVIRONMENT CONFIGURATION (.env.example)
# ==================================================

# ─── BACKEND CONFIG (server/.env) ─────────────────
# MongoDB connection URI (Atlas or local)
# Leave blank to use automated IN-MEMORY store fallback
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aegis?retryWrites=true&w=majority

# Backend Server Port
PORT=5000

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# Node Environment ('development' | 'production')
NODE_ENV=development

# ─── FRONTEND CONFIG (client/.env) ────────────────
# Set only in production deployment (e.g., Vercel)
# In local development, Vite proxies /api to http://localhost:5000 automatically
VITE_API_URL=
